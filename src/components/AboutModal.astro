---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const t = {
  es: {
    close: 'Cerrar',
    kicker: 'Sobre mí',
    title: '20 años de experiencia.',
    text: 'Llevo más de 20 años trabajando entre frontend, diseño digital y tecnología. Esa experiencia es la base desde la que hoy abordo cada proyecto: entender primero el problema y después elegir la herramienta adecuada.',
    point1: 'Frontend Design & Layout · UX/UI · SEO · Project Management · CMS',
    point2Strong: 'Formador de la Comunidad de Madrid',
    point2Rest: 'durante más de 10 años.',
  },
  en: {
    close: 'Close',
    kicker: 'About me',
    title: '20 years of experience.',
    text: 'I have spent more than 20 years working across frontend, digital design and technology. That experience is the foundation for how I approach every project today: understand the problem first, then choose the right tool.',
    point1: 'Frontend Design & Layout · UX/UI · SEO · Project Management · CMS',
    point2Strong: 'Trainer for the Madrid Regional Government',
    point2Rest: 'for over 10 years.',
  },
}[lang];
---

<div class="about-modal" id="aboutModal" data-about-modal role="dialog" aria-modal="true" aria-labelledby="aboutModalTitle">
  <div class="about-card">
    <button class="about-close" type="button" aria-label={t.close} data-about-close>×</button>

    <p class="about-kicker">{t.kicker}</p>
    <h2 id="aboutModalTitle">{t.title}</h2>

    <p class="about-text">{t.text}</p>

    <div class="about-points">
      <div class="about-point">
        <strong>{t.point1}</strong>
      </div>
      <div class="about-point">
        <strong>{t.point2Strong}</strong> {t.point2Rest}
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('aboutModal');
  const closeBtn = modal?.querySelector<HTMLButtonElement>('[data-about-close]');
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-about-trigger]');
  let lastTrigger: HTMLElement | null = null;

  const open = (event: Event) => {
    lastTrigger = event.currentTarget as HTMLElement;
    modal?.classList.add('is-active');
  };

  const close = () => {
    modal?.classList.remove('is-active');
    lastTrigger?.focus();
  };

  triggers.forEach((trigger) => trigger.addEventListener('click', open));
  closeBtn?.addEventListener('click', close);

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) close();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal?.classList.contains('is-active')) close();
  });
</script>

<style>
  .about-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--background) 80%, transparent);
    backdrop-filter: blur(16px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .28s ease, visibility .28s ease;
  }
  .about-modal.is-active { opacity: 1; visibility: visible; pointer-events: auto; }

  .about-card {
    width: min(100%, 480px);
    max-height: min(88vh, 640px);
    overflow-y: auto;
    position: relative;
    padding: 1.7rem 1.5rem 1.4rem;
    border: 1px solid color-mix(in srgb, #ff447c 28%, var(--border));
    border-radius: 1.4rem;
    background: color-mix(in srgb, #ff447c 4%, var(--surface));
    box-shadow: 0 30px 90px rgba(0, 0, 0, .35);
    transform: translateY(12px) scale(.985);
    transition: transform .32s ease;
  }
  .about-modal.is-active .about-card { transform: none; }

  .about-close {
    position: absolute;
    top: .9rem;
    right: .9rem;
    width: 2.15rem;
    height: 2.15rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--border);
    font-size: 1.15rem;
    cursor: pointer;
    transition: color .2s ease, border-color .2s ease;
  }
  .about-close:hover { color: var(--text); border-color: color-mix(in srgb, var(--text) 30%, var(--border)); }

  .about-kicker {
    margin: 0 0 .7rem;
    color: #ff447c;
    font: 700 .7rem/1 var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .about-card h2 {
    max-width: 92%;
    margin: 0 0 .9rem;
    color: var(--text);
    font: 400 clamp(2.3rem, 4.6vw, 3.1rem)/.92 var(--font-display);
    letter-spacing: -.01em;
    text-transform: uppercase;
  }

  .about-text {
    margin: 0;
    color: var(--muted);
    font-size: .88rem;
    line-height: 1.58;
  }

  .about-points { display: grid; gap: .6rem; margin-top: 1.1rem; }
  .about-point {
    padding: .78rem .85rem;
    border-radius: .8rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 3%, transparent);
    color: var(--muted);
    font-size: .82rem;
    line-height: 1.45;
  }
  .about-point strong { color: var(--text); }

  @media (max-width: 560px) {
    .about-card { padding: 1.4rem 1.2rem 1.2rem; }
  }
</style>
