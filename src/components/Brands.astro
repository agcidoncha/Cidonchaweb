---
const brands = [
  { name: 'El Corte Inglés', file: 'el-corte-ingles' },
  { name: 'Sanitas', file: 'sanitas' },
  { name: 'Mercedes-Benz', file: 'mercedes-benz' },
  { name: 'BMW', file: 'bmw', scale: 1.3 },
  { name: 'Endesa', file: 'endesa', scale: 0.7 },
  { name: 'Repsol', file: 'repsol' },
  { name: 'AMC', file: 'amc' },
  { name: 'Kinepolis', file: 'kinepolis' },
  { name: 'Autopía', file: 'autopia', scale: 0.7 },
  { name: 'Packlink', file: 'packlink' },
];
---

<section class="brands" aria-labelledby="brands-title">
  <p class="brands__intro" id="brands-title">Empresas con las que he colaborado</p>
  <ul class="brands__grid">
    {brands.map((brand, index) => (
      <li class="brands__item" style={`--delay: ${index * 60}ms`}>
        <span
          class="brands__mark"
          role="img"
          aria-label={brand.name}
          style={`--logo: url('/logos/${brand.file}.svg'); --scale: ${brand.scale ?? 1}`}
        ></span>
        <img
          src={`/logos/${brand.file}.svg`}
          alt=""
          aria-hidden="true"
          hidden
          onerror="this.closest('.brands__item').classList.add('is-broken')"
        />
        <span class="brands__fallback">{brand.name}</span>
      </li>
    ))}
  </ul>

  <p class="brands__cta">
    <a href="/portfolio">Ejemplos de trabajos <span aria-hidden="true">→</span></a>
  </p>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('.brands__item');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion) {
    items.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.2 }
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  .brands { width: min(100% - 2.5rem, 84rem); margin: 0 auto; padding: 3rem 0 clamp(3rem, 5vw, 5rem); }
  .brands__intro { margin: 0 0 1.6rem; color: var(--muted); text-align: center; font: 600 .78rem/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .brands__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .brands__item { display: grid; place-items: center; min-height: 5rem; padding: 1rem; border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); opacity: 0; transform: translateY(14px); transition: opacity .5s ease var(--delay), transform .5s ease var(--delay); }
  .brands__item.is-visible { opacity: 1; transform: translateY(0); }

  .brands__mark { display: block; width: 100%; height: 2.2rem; background-color: var(--muted); -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; transform: scale(var(--scale, 1)); transition: background-color .25s ease; }
  .brands__item:hover .brands__mark { background-color: var(--text); }

  .brands__fallback { display: none; color: var(--muted); font: 600 .72rem/1.2 var(--font-mono); letter-spacing: .03em; text-align: center; }
  .brands__item.is-broken .brands__mark { display: none; }
  .brands__item.is-broken .brands__fallback { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .brands__item { transition: none; }
  }

  .brands__cta { margin: 2rem 0 0; text-align: center; }
  .brands__cta a { display: inline-flex; align-items: center; gap: .4rem; color: var(--text); font: 600 .82rem/1 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: .3rem; transition: border-color .25s ease, color .25s ease; }
  .brands__cta a:hover { color: var(--muted); border-color: var(--text); }
  .brands__cta a span { transition: transform .25s ease; }
  .brands__cta a:hover span { transform: translateX(3px); }

  @media (max-width: 900px) {
    .brands__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .brands { width: min(100% - 1.5rem, 84rem); }
    .brands__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
