---
const ICONS: Record<string, string> = {
  layout: '<rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect>',
  palette: '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c1.1 0 2-.9 2-2 0-.52-.2-.99-.53-1.34-.32-.34-.52-.8-.52-1.31 0-1.1.9-2 2-2h2.35c2.31 0 4.2-1.89 4.2-4.2C21.5 6.03 17.19 2 12 2Z"></path><circle cx="7" cy="12" r="1"></circle><circle cx="9.5" cy="7.5" r="1"></circle><circle cx="14.5" cy="7.5" r="1"></circle><circle cx="17" cy="12" r="1"></circle>',
  code: '<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>',
  check: '<polyline points="20 6 9 17 4 12"></polyline>',
  database: '<ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"></path>',
  settings: '<circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path>',
  search: '<circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>',
  sparkles: '<path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3Z"></path><path d="M5 3.5l.5 1.5 1.5.5-1.5.5-.5 1.5-.5-1.5L3 5.5l1.5-.5.5-1.5Z"></path><path d="M19 15l.5 1.5 1.5.5-1.5.5-.5 1.5-.5-1.5-1.5-.5 1.5-.5.5-1.5Z"></path>',
  share: '<circle cx="18" cy="5" r="2.5"></circle><circle cx="6" cy="12" r="2.5"></circle><circle cx="18" cy="19" r="2.5"></circle><line x1="8.3" y1="10.7" x2="15.7" y2="6.8"></line><line x1="8.3" y1="13.3" x2="15.7" y2="17.2"></line>',
};
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[name] ?? ''}</svg>`;

const wirePaths = [
  'M200 56 C280 56 340 56 420 56',
  'M420 92 C420 140 200 122 200 169',
  'M200 169 C280 169 340 169 420 169',
];

const scenes = [
  {
    id: 'diseno',
    accent: '#ff684b',
    eyebrow: 'DISEÑO · MAQUETACIÓN',
    title: ['Usabilidad y diseño', 'intuitivos.'],
    subtitle: 'Interfaces claras, maquetadas con código limpio y responsive.',
    flowLabel: 'FLUJO DE DISEÑO',
    nodes: [
      { icon: 'layout', title: 'Wireframe', small: 'Estructura' },
      { icon: 'palette', title: 'Sistema visual', small: 'Color y tipografía' },
      { icon: 'code', title: 'Maquetación', small: 'HTML y CSS' },
      { icon: 'check', title: 'Publicado', small: 'Cualquier dispositivo' },
    ],
  },
  {
    id: 'wordpress',
    accent: '#9c64f4',
    eyebrow: 'WORDPRESS · CMS',
    title: ['WordPress que', 'tu equipo puede mantener.'],
    subtitle: 'Themes a medida con WordPress, ACF y CPT, sin depender de un desarrollador para editar.',
    flowLabel: 'FLUJO WORDPRESS',
    nodes: [
      { icon: 'database', title: 'Arquitectura', small: 'CPT y ACF' },
      { icon: 'layout', title: 'Theme a medida', small: 'Plantillas propias' },
      { icon: 'settings', title: 'Panel editable', small: 'Sin tocar código' },
      { icon: 'check', title: 'Publicado', small: 'Estable en el tiempo' },
    ],
  },
  {
    id: 'ia',
    accent: '#38d7bc',
    eyebrow: 'IA · AUTOMATIZACIÓN',
    title: ['IA adaptada', 'a cada necesidad.'],
    subtitle: 'IA y automatización aplicadas al desarrollo, la documentación y la coordinación de proyectos.',
    flowLabel: 'FLUJO CON IA',
    nodes: [
      { icon: 'search', title: 'Detecta', small: 'Tarea o proceso' },
      { icon: 'sparkles', title: 'Agente', small: 'Claude, Codex, n8n' },
      { icon: 'share', title: 'Conecta', small: 'APIs y MCP' },
      { icon: 'check', title: 'Automatiza', small: 'Libera tiempo' },
    ],
  },
];
---

<div class="hero-wrap">
  <main class="hero">
    <div class="hero__copy">
      <p class="hero__eyebrow" id="heroEyebrow"></p>
      <h1 class="hero__title" id="heroTitle">
        <span class="hero__title-line" id="titleLine1"></span>
        <span class="hero__title-line hero__title-line--accent" id="titleLine2"></span>
      </h1>
      <p class="hero__subtitle" id="heroSubtitle"></p>

      <div class="hero__dots" id="heroDots" role="tablist" aria-label="Escenas del hero">
        {scenes.map((scene, i) => (
          <button class="hero__dot" type="button" data-index={i} role="tab" aria-label={scene.eyebrow} style={`--accent: ${scene.accent}`}></button>
        ))}
      </div>
    </div>

    <div class="hero__panel" id="heroPanel">
      <div class="hero__panel-topbar">
        <span></span><span></span><span></span>
      </div>
      <div class="hero__panel-body">
        {scenes.map((scene, i) => (
          <div class={`hero__scene ${i === 0 ? 'is-active' : ''}`} data-scene={scene.id} style={`--accent: ${scene.accent}`}>
            <div class="hero__diagram">
              <svg viewBox="0 0 620 225" preserveAspectRatio="none">
                <defs>
                  <linearGradient id={`wireGradient-${scene.id}`} x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color={scene.accent} stop-opacity="0.2"></stop>
                    <stop offset="50%" stop-color={scene.accent}></stop>
                    <stop offset="100%" stop-color={scene.accent} stop-opacity="0.2"></stop>
                  </linearGradient>
                </defs>
                {wirePaths.map((d, wi) => (
                  <>
                    <path class="wire" d={d}></path>
                    <path class={`wire-run wire-run--${wi + 1}`} style={`stroke: url(#wireGradient-${scene.id})`} d={d}></path>
                  </>
                ))}
              </svg>

              {scene.nodes.map((node, ni) => (
                <div class={`diagram-node node--${ni + 1}`}>
                  <span class="diagram-node__icon" set:html={icon(node.icon)} />
                  <span class="diagram-node__copy"><strong>{node.title}</strong><small>{node.small}</small></span>
                </div>
              ))}
            </div>
            <span class="hero__scene-label">{scene.flowLabel}</span>
          </div>
        ))}
      </div>
    </div>
  </main>
</div>

<script define:vars={{ scenesData: scenes }}>
  const heroEl = document.querySelector('.hero');
  const eyebrow = document.getElementById('heroEyebrow');
  const line1 = document.getElementById('titleLine1');
  const line2 = document.getElementById('titleLine2');
  const subtitle = document.getElementById('heroSubtitle');
  const dots = Array.from(document.querySelectorAll('.hero__dot'));
  const sceneEls = Array.from(document.querySelectorAll('.hero__scene'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let index = 0;
  let timer = null;

  function activate(i) {
    index = i;
    const scene = scenesData[i];

    eyebrow.textContent = scene.eyebrow;
    line1.textContent = scene.title[0];
    line2.textContent = scene.title[1];
    subtitle.textContent = scene.subtitle;
    heroEl.style.setProperty('--accent', scene.accent);

    dots.forEach((d, di) => d.classList.toggle('is-active', di === i));

    sceneEls.forEach((el, ei) => {
      el.classList.toggle('is-active', ei === i);
      el.classList.remove('play-sequence');
    });

    if (!reduceMotion) {
      const activeScene = sceneEls[i];
      void activeScene.offsetWidth;
      activeScene.classList.add('play-sequence');
    }
  }

  function scheduleNext() {
    if (reduceMotion) return;
    timer = window.setTimeout(() => {
      activate((index + 1) % scenesData.length);
      scheduleNext();
    }, 4200);
  }

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      if (timer) window.clearTimeout(timer);
      activate(Number(dot.dataset.index));
      scheduleNext();
    });
  });

  activate(0);
  scheduleNext();
</script>

<style>
  .hero-wrap {
    position: relative;
    background:
      radial-gradient(circle at 18% 22%, rgba(156, 100, 244, 0.10), transparent 38%),
      radial-gradient(circle at 82% 18%, rgba(56, 215, 188, 0.10), transparent 40%),
      radial-gradient(circle at 75% 80%, rgba(67, 140, 239, 0.09), transparent 42%),
      var(--background);
    background-image:
      radial-gradient(circle at 18% 22%, rgba(156, 100, 244, 0.10), transparent 38%),
      radial-gradient(circle at 82% 18%, rgba(56, 215, 188, 0.10), transparent 40%),
      radial-gradient(circle at 75% 80%, rgba(67, 140, 239, 0.09), transparent 42%),
      radial-gradient(color-mix(in srgb, var(--text) 5%, transparent) 1px, transparent 1px);
    background-size: auto, auto, auto, 32px 32px;
    border-bottom: 1px solid var(--border);
  }

  .hero {
    width: min(100% - 2.5rem, 84rem);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
    padding: 3rem 0;
  }

  .hero__eyebrow {
    min-height: 1em;
    margin: 0 0 1.1rem;
    color: var(--muted);
    font: 700 0.72rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    transition: color 0.3s ease;
  }

  .hero__title {
    margin: 0 0 1.3rem;
    color: var(--text);
    font: 400 clamp(2.6rem, 5.6vw, 4.6rem)/1.02 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    min-height: 2.1em;
  }
  .hero__title-line { display: block; }
  .hero__title-line--accent { color: var(--accent, #ff447c); transition: color 0.3s ease; }

  .hero__subtitle {
    margin: 0 0 1.1rem;
    max-width: 42ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .hero__dots {
    display: flex;
    gap: 0.6rem;
  }
  .hero__dot {
    width: 2.4rem;
    height: 4px;
    border-radius: 999px;
    border: 0;
    background: var(--border);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .hero__dot.is-active { background: var(--accent); }
  .hero__dot:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }

  .hero__panel {
    position: relative;
    border-radius: 1.6rem;
    border: 1px solid color-mix(in srgb, var(--accent, #7a5cff) 28%, var(--border));
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface) 90%, white 2%), var(--surface));
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.35);
    padding: 1rem;
    transition: border-color 0.4s ease;
  }

  .hero__panel-topbar {
    display: flex;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem 0.9rem;
  }
  .hero__panel-topbar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text) 20%, transparent);
  }

  .hero__panel-body {
    position: relative;
    height: 18.6rem;
    border-radius: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--text) 6%, transparent);
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--accent, #7a5cff) 10%, transparent), transparent 40%),
      radial-gradient(color-mix(in srgb, var(--text) 5%, transparent) 1px, transparent 1px);
    background-size: auto, 22px 22px;
    padding: 1.4rem;
    overflow: hidden;
  }

  .hero__scene {
    position: absolute;
    inset: 1.4rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease, visibility 0s linear 0.4s;
  }
  .hero__scene.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.4s ease, transform 0.4s ease, visibility 0s;
  }

  .hero__scene-label {
    display: block;
    margin-top: 0.8rem;
    text-align: right;
    color: color-mix(in srgb, var(--accent) 72%, var(--muted));
    font: 600 0.62rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .hero__diagram {
    position: relative;
    width: 100%;
    height: 15.2rem;
  }
  .hero__diagram svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero__diagram :global(.wire) {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 14%, transparent);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .hero__diagram :global(.wire-run) {
    fill: none;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 10 155;
    stroke-dashoffset: 165;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--accent) 55%, transparent));
  }

  .diagram-node {
    position: absolute;
    width: max-content;
    min-height: 4.4rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.9rem;
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.65rem;
    align-items: center;
    background: color-mix(in srgb, var(--accent) 6%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.3);
    opacity: 0.92;
  }
  :root[data-theme='light'] .diagram-node { border-color: color-mix(in srgb, var(--text) 24%, transparent); box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1); }
  .diagram-node::before,
  .diagram-node::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--background);
    border: 2px solid color-mix(in srgb, var(--text) 30%, transparent);
    transform: translateY(-50%);
  }
  .diagram-node::before { left: -5px; }
  .diagram-node::after { right: -5px; }

  .diagram-node__icon { width: 2.6rem; height: 2.6rem; border-radius: 0.65rem; display: grid; place-items: center; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  :root[data-theme='light'] .diagram-node__icon { border-color: color-mix(in srgb, var(--accent) 48%, transparent); background: color-mix(in srgb, var(--accent) 16%, transparent); }
  .diagram-node__icon :global(svg) { width: 1.15rem; height: 1.15rem; }
  .diagram-node__copy strong { display: block; color: var(--text); font-size: 0.92rem; line-height: 1.15; margin-bottom: 0.15rem; white-space: nowrap; }
  .diagram-node__copy small { display: block; color: var(--muted); font-size: 0.74rem; line-height: 1.15; white-space: nowrap; }

  .node--1 { left: 0%; top: 6%; }
  .node--2 { right: 0%; top: 6%; }
  .node--3 { left: 0%; top: 60%; }
  .node--4 { right: 0%; top: 60%; }

  .hero__scene.play-sequence .hero__diagram :global(.wire-run) {
    animation: heroWireDraw 2.4s linear 1 forwards;
  }
  .hero__diagram :global(.wire-run--2) { animation-delay: 0.35s !important; }
  .hero__diagram :global(.wire-run--3) { animation-delay: 0.7s !important; }

  .hero__scene.play-sequence .diagram-node {
    animation: heroNodePulse 2.6s ease 1 forwards;
  }
  .node--2 { animation-delay: 0.35s; }
  .node--3 { animation-delay: 0.7s; }
  .node--4 { animation-delay: 1.05s; }

  @keyframes heroWireDraw {
    from { stroke-dashoffset: 165; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes heroNodePulse {
    0%, 100% { opacity: 0.9; transform: translateY(0) scale(1); border-color: color-mix(in srgb, var(--text) 12%, transparent); }
    16% { opacity: 1; transform: translateY(-3px) scale(1.02); border-color: color-mix(in srgb, var(--accent) 60%, transparent); box-shadow: 0 14px 28px rgba(0, 0, 0, 0.3), 0 0 16px color-mix(in srgb, var(--accent) 30%, transparent); }
    32% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scene { transition: none; }
    .diagram-node { animation: none; opacity: 1; }
    .hero__diagram :global(.wire-run) { animation: none; stroke-dashoffset: 0; }
  }

  @media (max-width: 900px) {
    .hero { width: min(100% - 1.5rem, 84rem); grid-template-columns: 1fr; padding-top: 2.5rem; }
    .hero__panel-body { height: auto; min-height: 18.6rem; }
  }
</style>
