---

<BaseLayout title={t.metaTitle} description={t.metaDescription} lang={lang}>
  <main class="portfolio-page">
    <section class="portfolio">
      <div class="portfolio__intro">
        <h1>{t.heading}</h1>
        <p class="portfolio__subtitle">{t.subtitle}</p>
      </div>

      <div class="portfolio__grid">
        {projects.map((project) => (
          <a
            class="portfolio-card"
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            style={`--accent: ${project.accent}`}
          >
            <div class="portfolio-card__media">
              <img
                src={project.img}
                alt={t.alt(project.name)}
                loading="lazy"
                decoding="async"
                onerror="this.hidden=true;this.nextElementSibling.hidden=false;"
              />
              <span class="portfolio-card__fallback" hidden>{project.name}</span>
            </div>
            <div class="portfolio-card__body">
              <h2>{project.name}</h2>
              <p>{project.description[lang]}</p>
              <div class="portfolio-card__tags">
                {project.tags[lang].map((tag) => <span>{tag}</span>)}
              </div>
              <span class="portfolio-card__link">{t.link} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .portfolio-page {
    min-height: 100svh;
    background: var(--background);
  }

  .portfolio {
    width: min(100% - 2.5rem, 84rem);
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  .portfolio__intro {
    text-align: center;
  }

  .portfolio__intro h1 {
    margin: 0;
    font: 400 clamp(3rem, 4.6vw, 5rem)/.9 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--text);
  }

  .portfolio__subtitle {
    margin: 1.1rem 0 0;
    color: var(--muted);
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
    font-weight: 600;
  }

  .portfolio__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin-top: clamp(2.25rem, 3.5vw, 3rem);
  }

  .portfolio-card {
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
    border-radius: 1.3rem;
    background: color-mix(in srgb, var(--accent) 4%, var(--surface));
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .portfolio-card:hover {
    transform: translateY(-0.4rem);
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }
  .portfolio-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .portfolio-card__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 6%, var(--background));
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
  }
  .portfolio-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1);
    transition: filter 0.4s ease, transform 0.4s ease;
  }
  .portfolio-card:hover .portfolio-card__media img {
    filter: grayscale(0);
    transform: scale(1.04);
  }

  @media (min-width: 901px) {
    .portfolio-card__media img { filter: grayscale(1) blur(4px); transform: scale(1.06); }
    .portfolio-card:hover .portfolio-card__media img { filter: grayscale(0) blur(0); transform: scale(1.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-card__media img { transition: none; filter: grayscale(1); transform: none; }
    .portfolio-card:hover .portfolio-card__media img { transform: none; }
  }
  .portfolio-card__fallback {
    padding: 1rem;
    color: var(--muted);
    font: 600 0.9rem/1.2 var(--font-mono);
    text-align: center;
  }

  .portfolio-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.6rem;
    padding: 1.3rem 1.4rem 1.5rem;
  }

  .portfolio-card__body h2 {
    margin: 0;
    color: var(--text);
    font: 400 1.5rem/1.05 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .portfolio-card__body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.45;
    flex: 1;
  }

  .portfolio-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .portfolio-card__tags span {
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    font: 600 0.62rem/1 var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .portfolio-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.3rem;
    color: var(--accent);
    font: 600 0.72rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .portfolio-card__link span {
    transition: transform 0.25s ease;
  }
  .portfolio-card:hover .portfolio-card__link span {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .portfolio__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .portfolio { width: min(100% - 1.5rem, 84rem); padding-top: 2.5rem; }
    .portfolio__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
