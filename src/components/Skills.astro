---

<main class="skills-page">
  <section class="skills" aria-labelledby="skills-title">
    <div class="skills__intro">
      <h2 id="skills-title">{page.heading}</h2>
      <p class="skills__subtitle">{page.subtitle}</p>
    </div>

    <div class="skills__board" id="skillsBoard" aria-label={page.boardLabel}>
      <button class="skill-nav skill-nav-prev" type="button" aria-label={page.prev}>
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="skill-nav skill-nav-next" type="button" aria-label={page.next}>
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      {skillGroups.map((group) => (
        <article class="skill-card" data-skill={group.id} style={`--accent: ${group.accent}`}>
          <span class="skill-card__index">{group.number} · {group.tag[lang]}</span>
          <button class="skill-card__drag" type="button" aria-label={page.drag(group.title[lang])}>
            <span class="skill-card__grip" aria-hidden="true"></span>
          </button>
          <button class="skill-card__open" type="button" aria-expanded="false">
            <span class="skill-card__title">{group.title[lang]}</span>
          </button>
          <span class="skill-card__tap" aria-hidden="true">+</span>
          <button class="skill-card__close" type="button" aria-label={page.close(group.title[lang])}>
            <span>{page.closeLabel}</span> ×
          </button>
          <div class="skill-card__body"><div class="skill-card__body-inner">
            <div class="skill-card__layout">
              <div class="skill-card__copy">
                <p>{group.intro[lang]}</p>
                <ul>
                  {group.items[lang].map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{item}</strong></li>)}
                </ul>
              </div>
              <div class="skill-card__flow" data-flow-label={group.flowLabel[lang]} aria-label={page.flowFor(group.title[lang])}>
                {group.steps.map((step, index) => (
                  <div class={`flow-step flow-step--${index + 1}`}>
                    <div class="flow-icon" set:html={icon(step.icon)} />
                    <div class="flow-copy"><strong>{step.title[lang]}</strong><span>{step.desc[lang]}</span></div>
                    <div class="flow-status">{step.status[lang]}</div>
                  </div>
                ))}
              </div>
            </div>
          </div></div>
        </article>
      ))}
    </div>
    <p class="skills__hint">
      <span><strong>{page.hintTap}</strong> {page.hintTapRest}</span>
      <span><strong>{page.hintDrag}</strong> {page.hintDragRest}</span>
    </p>
  </section>
</main>

<script>
  const board = document.getElementById('skillsBoard');
  const cards = board ? Array.from(board.querySelectorAll<HTMLElement>('.skill-card')) : [];

  function closeCard(card: HTMLElement) {
    card.classList.remove('is-open', 'play-sequence');
    card.querySelector('.skill-card__open')?.setAttribute('aria-expanded', 'false');
  }

  function closeBoard() {
    cards.forEach(closeCard);
  }

  function openCard(card: HTMLElement) {
    if (card.classList.contains('is-open')) return;
    cards.forEach(closeCard);
    card.classList.add('is-open');
    card.querySelector('.skill-card__open')?.setAttribute('aria-expanded', 'true');

    card.classList.remove('play-sequence');
    void card.offsetWidth;
    card.classList.add('play-sequence');

    window.setTimeout(() => {
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }, 80);

    positionSkillNav();
  }

  const skillNavPrev = board?.querySelector<HTMLButtonElement>('.skill-nav-prev');
  const skillNavNext = board?.querySelector<HTMLButtonElement>('.skill-nav-next');

  function positionSkillNav() {
    if (!board || !skillNavPrev || !skillNavNext) return;

    if (window.innerWidth > 1300) {
      [skillNavPrev, skillNavNext].forEach((btn) => {
        btn.style.left = '';
        btn.style.right = '';
        btn.style.top = '';
      });
      return;
    }

    const openCardEl = board.querySelector<HTMLElement>('.skill-card.is-open');
    const title = openCardEl?.querySelector<HTMLElement>('.skill-card__title');
    if (!openCardEl || !title) return;

    const boardRect = board.getBoundingClientRect();
    const titleRect = title.getBoundingClientRect();
    const closeButton = openCardEl.querySelector<HTMLElement>('.skill-card__close');
    const closeRect = closeButton?.getBoundingClientRect();

    const prevWidth = skillNavPrev.offsetWidth || 36;
    const nextWidth = skillNavNext.offsetWidth || 36;
    const betweenButtons = 8;
    const titleGap = 16;

    let startLeft = titleRect.right - boardRect.left + titleGap;

    if (closeRect) {
      const closeLeft = closeRect.left - boardRect.left;
      const maxStart = closeLeft - 16 - prevWidth - betweenButtons - nextWidth;
      startLeft = Math.min(startLeft, maxStart);
    }

    const absoluteMax = boardRect.width - 12 - prevWidth - betweenButtons - nextWidth;
    startLeft = Math.min(startLeft, absoluteMax);
    startLeft = Math.max(12, startLeft);

    const titleCenterY = titleRect.top - boardRect.top + titleRect.height / 2;

    skillNavPrev.style.left = `${startLeft}px`;
    skillNavPrev.style.right = 'auto';
    skillNavPrev.style.top = `${titleCenterY}px`;

    skillNavNext.style.left = `${startLeft + prevWidth + betweenButtons}px`;
    skillNavNext.style.right = 'auto';
    skillNavNext.style.top = `${titleCenterY}px`;
  }

  function goToAdjacentCard(direction: 1 | -1) {
    if (!board) return;
    const order = Array.from(board.querySelectorAll<HTMLElement>('.skill-card'));
    const openCardEl = board.querySelector<HTMLElement>('.skill-card.is-open');
    if (!openCardEl) return;
    const currentIndex = order.indexOf(openCardEl);
    const nextIndex = (currentIndex + direction + order.length) % order.length;
    openCard(order[nextIndex]);
  }

  skillNavPrev?.addEventListener('click', (event) => {
    event.stopPropagation();
    goToAdjacentCard(-1);
  });
  skillNavNext?.addEventListener('click', (event) => {
    event.stopPropagation();
    goToAdjacentCard(1);
  });

  window.addEventListener('resize', positionSkillNav, { passive: true });

  cards.forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>('.skill-card__open');
    const close = card.querySelector<HTMLButtonElement>('.skill-card__close');
    trigger?.addEventListener('click', () => openCard(card));
    close?.addEventListener('click', (event) => {
      event.stopPropagation();
      closeBoard();
      trigger?.focus({ preventScroll: true });
    });
  });

  document.addEventListener('click', (event) => {
    const openCardEl = board?.querySelector<HTMLElement>('.skill-card.is-open');
    if (!openCardEl || openCardEl.contains(event.target as Node)) return;
    closeBoard();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openCardEl = board?.querySelector<HTMLElement>('.skill-card.is-open');
    if (!openCardEl) return;
    closeBoard();
    openCardEl.querySelector<HTMLButtonElement>('.skill-card__open')?.focus({ preventScroll: true });
  });

  if (board) {
    type DragState = {
      pointerId: number;
      card: HTMLElement;
      ghost: HTMLElement;
      offsetX: number;
      offsetY: number;
    };
    let drag: DragState | null = null;

    board.querySelectorAll<HTMLButtonElement>('.skill-card__drag').forEach((handle) => {
      handle.addEventListener('pointerdown', (event) => {
        const card = handle.closest<HTMLElement>('.skill-card');
        if (!card || card.classList.contains('is-open') || board.querySelector('.skill-card.is-open')) return;

        event.preventDefault();

        const rect = card.getBoundingClientRect();
        const ghost = card.cloneNode(true) as HTMLElement;
        ghost.classList.remove('is-open', 'is-drag-source', 'play-sequence');
        ghost.classList.add('skill-card--ghost');
        ghost.style.width = `${rect.width}px`;
        ghost.style.height = `${rect.height}px`;
        ghost.style.left = `${rect.left}px`;
        ghost.style.top = `${rect.top}px`;
        ghost.querySelectorAll('button,a').forEach((el) => el.setAttribute('tabindex', '-1'));
        document.body.appendChild(ghost);

        card.classList.add('is-drag-source');
        document.body.classList.add('is-dragging-skills');

        drag = {
          pointerId: event.pointerId,
          card,
          ghost,
          offsetX: event.clientX - rect.left,
          offsetY: event.clientY - rect.top,
        };
      });
    });

    document.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      event.preventDefault();

      drag.ghost.style.left = `${event.clientX - drag.offsetX}px`;
      drag.ghost.style.top = `${event.clientY - drag.offsetY}px`;

      drag.ghost.style.visibility = 'hidden';
      const under = document.elementFromPoint(event.clientX, event.clientY);
      drag.ghost.style.visibility = 'visible';

      const target = under?.closest<HTMLElement>('.skill-card');
      if (!target || target === drag.card || target.parentElement !== board) return;

      const r = target.getBoundingClientRect();
      const horizontalBand = Math.abs(event.clientY - (r.top + r.height / 2)) < r.height * 0.18;
      const after = event.clientY > r.top + r.height / 2 || (horizontalBand && event.clientX > r.left + r.width / 2);

      const reference = after ? target.nextSibling : target;
      if (reference !== drag.card) board.insertBefore(drag.card, reference);
    }, { passive: false });

    function finishDrag(event: PointerEvent) {
      if (!drag || event.pointerId !== drag.pointerId) return;
      drag.card.classList.remove('is-drag-source');
      drag.ghost.remove();
      document.body.classList.remove('is-dragging-skills');
      drag = null;
    }

    document.addEventListener('pointerup', finishDrag);
    document.addEventListener('pointercancel', finishDrag);
  }
</script>

<style>
  .skills-page { background: var(--background); }

  .skills { width: min(100% - 2.5rem, 84rem); margin: 0 auto; padding: clamp(2.5rem, 4vw, 4rem) 0 3rem; }
  .skills__intro { text-align: center; }
  #skills-title { margin: 0; font: 400 clamp(3rem, 4.6vw, 5rem)/.9 var(--font-display); letter-spacing: -.01em; text-transform: uppercase; }
  .skills__subtitle { margin: 1.1rem 0 0; color: var(--muted); font-size: clamp(.9rem, 1.3vw, 1.05rem); font-weight: 600; }

  .skills__board { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; margin-top: clamp(2.25rem, 3.5vw, 3rem); }

